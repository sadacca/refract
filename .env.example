# --- Required for Groq eval (Pass 0/1/2/3) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Required for Gemini judge (Pass 4, cross-family) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional: Cerebras (faster / higher RPD than Groq, same model families) ---
CEREBRAS_API_KEY=your_cerebras_api_key_here

# --- Optional: Mistral (300 RPM free, 1B tokens/month) ---
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Optional: Guardian article fetcher ---
GUARDIAN_API_KEY=your_guardian_api_key_here

# --- Model selection ---
# Any provider model may serve as eval OR judge — role assignment is fully flexible.
# Prefix with provider to disambiguate models available on multiple platforms:
#   cerebras/gpt-oss-120b   cerebras/qwen-3-235b   mistral-large-latest
#   gemini-2.5-flash        llama-3.3-70b-versatile          mistral-large-latest
#
# Eval model (Pass 2 identification). Default: Llama-3.3-70B on Groq (MMLU 86.0%; 128K ctx).
EVAL_MODEL=llama-3.3-70b-versatile

# Judge model (Pass 4 verdict). Empty = auto cross-family:
#   non-Gemini eval → gemini-3.1-flash-lite; Gemini eval → llama-3.3-70b-versatile
JUDGE_MODEL=

# Triage model (Pass 0/1/3 — small/fast). Groq or Cerebras llama-3.1-8b.
TRIAGE_MODEL=llama-3.1-8b-instant

# --- Pipeline settings ---
EVAL_MODE=deep
RATE_LIMIT_DELAY=5

# --- Rate limiting overrides ---
# LLM_CALL_INTERVAL=6       # Minimum seconds between same-model calls (default 6)
# LLM_POST_CALL_DELAY=2.0   # Global post-call pause across all models (default 2.0)
